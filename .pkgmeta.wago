package-as: Homestead
enable-nolib-creation: no
manual-changelog:
  filename: RELEASE_NOTES.html
  markup-type: html

ignore:
  - .git
  - .gitignore
  - .pkgmeta
  - .pkgmeta.wago
  - .claude
  - "*.md"
  - "!README.md"
  - "!CHANGELOG.md"
  - RELEASE_NOTES.html
  - HousingAddon.toc

externals:
  Libs/Foundry-1.0:
    # Embedded inside Libs/ — one addon folder in the zip, no sibling-folder
    # issues. Standalone Foundry-1.0 wins via OptionalDeps ordering when installed;
    # this embed stands down silently via the v1.0.4 bootstrap gate.
    url: https://github.com/Royaleint/Foundry.git
    tag: v1.0.4
  Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibDataBroker-1.1: https://repos.wowace.com/wow/libdatabroker-1-1
  Libs/WagoAnalytics:
    url: https://github.com/wagoio/WagoAnalyticsShim.git
    branch: main
