package-as: Homestead
enable-nolib-creation: no
manual-changelog:
  filename: RELEASE_NOTES.html
  markup-type: html

ignore:
  - .git
  - .gitignore
  - .pkgmeta
  - .pkgmeta.wago
  - .claude
  - .github
  - .luacheckrc
  - .luarc.json
  - "*.md"
  - "!README.md"
  - "!CHANGELOG.md"
  - RELEASE_NOTES.html
  - HousingAddon.toc

# Foundry-1.0 is no longer a build-time external: it is vendored in the repo at
# Libs/Foundry-1.0/ (HS-120), so it ships from the checkout on every platform.
externals:
  Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibDataBroker-1.1: https://repos.wowace.com/wow/libdatabroker-1-1
  Libs/WagoAnalytics:
    url: https://github.com/wagoio/WagoAnalyticsShim.git
    branch: main
