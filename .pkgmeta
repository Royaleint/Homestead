package-as: Homestead
enable-nolib-creation: no
manual-changelog:
  filename: RELEASE_NOTES.html
  markup-type: html

ignore:
  - .git
  - .gitignore
  - .pkgmeta
  - .claude
  - .github
  - .luacheckrc
  - .luarc.json
  - Home_Dev
  - api-docs
  - output
  - "*.py"
  - "*.pyc"
  - "*.md"
  - "!README.md"
  - "!CHANGELOG.md"
  - RELEASE_NOTES.html
  - HousingAddon.toc
  # STU-073 dev-build files (generated, gitignored; listed here as belt-and-braces —
  # the STU-064 TOC-vs-zip check expects exactly one TOC in the packaged zip)
  - Homestead_DevBuild.toc
  - DevBuildGuard.lua
  # HS-282: dev-only memory diagnostics -- tracked in git (so the DevBuild can
  # load them) but never listed in Homestead.toc; ignored here too so players
  # never download the dead weight.
  - Core/MemoryEstimator.lua
  - Core/DevMemoryDiagnostics.lua
  # HS-351/HS-284: the test suite (plain Lua harnesses invoked outside the
  # TOC, never loaded in-game) was shipping to every player who downloaded a
  # release zip -- no ignore entry existed for it at all.
  - tests
  # HS-374: the retired vendor seed (194 KB) is in neither TOC and has not
  # loaded in-game since the cutover, but was still in every release zip. It
  # stays in the repo because both vendor generators read it at build time.
  - Data/VendorDatabase.lua

# CF-only upload metadata: the packager sends this as a CurseForge relation
# when a CF project id is active. Wago's upload API has no dependency field,
# so the Wago packager steps (-p 0) simply never use it — one recipe serves
# both platforms. (Foundry itself is vendored at Libs/Foundry-1.0/ per HS-120;
# the relation is a CF-page listing, not a packaging instruction.)
required-dependencies:
  - foundry

externals:
  Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibDataBroker-1.1: https://repos.wowace.com/wow/libdatabroker-1-1
  Libs/WagoAnalytics:
    url: https://github.com/wagoio/WagoAnalyticsShim.git
    branch: main
